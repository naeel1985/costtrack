# Copy to .env and fill in. Generate SERVER_KEY / SESSION_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Neon: DATABASE_URL is the pooled URL (append &pgbouncer=true); DIRECT_URL is unpooled.
DATABASE_URL="postgresql://USER:PASS@EP-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASS@EP.REGION.aws.neon.tech/neondb?sslmode=require"
APP_URL="http://localhost:3000"
NODE_ENV="development"

SERVER_KEY="<base64 32-byte key>"
SESSION_SECRET="<base64 32-byte key>"

ADMIN_USERNAME="admin"
ADMIN_PASSWORD="<strong password>"
ADMIN_EMAIL="admin@example.com"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Cashflow <no-reply@cashflow.local>"

LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCKOUT_MINUTES="15"
