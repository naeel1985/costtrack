# Copy to .env and fill in. Generate SERVER_KEY / SESSION_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Neon: DATABASE_URL is the pooled URL (append &pgbouncer=true); DIRECT_URL is unpooled.
DATABASE_URL="postgresql://USER:PASS@EP-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASS@EP.REGION.aws.neon.tech/neondb?sslmode=require"
APP_URL="http://localhost:3000"
NODE_ENV="development"

SERVER_KEY="<base64 32-byte key>"
SESSION_SECRET="<base64 32-byte key>"

ADMIN_USERNAME="admin"
ADMIN_PASSWORD="<strong password>"
ADMIN_EMAIL="admin@example.com"

# Email. Leave SMTP_HOST empty to fall back to ./dev-outbox (no real send).
# Gmail example (use a 16-char App Password, NOT your normal password):
#   Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-16-char-app-password"
MAIL_FROM="Cashflow <you@gmail.com>"

LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCKOUT_MINUTES="15"
