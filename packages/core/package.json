{
  "name": "@cashflow/core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure, dependency-light financial engines shared by the web and mobile apps. No Node builtins, no DB — only date-fns. The source of truth for all money logic.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["src"],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "date-fns": "^4.4.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
