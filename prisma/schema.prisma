// Prisma schema — multi-user, encrypted, PostgreSQL.
//
// Security model (see DECISIONS.md for the full rationale):
// - Every user-owned row carries `userId` and is only ever queried through the
//   authenticated user's id. Admins never query these tables.
// - Sensitive financial fields are stored as AES-256-GCM ciphertext (base64) in
//   `String` columns, encrypted with a per-user Data Encryption Key (DEK). The
//   DEK is wrapped by a key derived from the user's password, so nobody — not
//   another user, not the admin, not someone with a DB dump — can decrypt a
//   user's data without that user's password.
// - Columns needed for querying/sorting (ids, type, status, currency, dates,
//   flags) stay plaintext; they are low-sensitivity without the amounts/names.
// - User *identity* (email, phone, full name) is plaintext because the admin is
//   explicitly allowed to see it; only financial DATA is DEK-encrypted.

generator client {
  provider = "prisma-client-js"
  // `native` = the machine that runs `prisma generate` (so the postinstall on
  // cPanel produces the right engine). The extra target is a fallback for
  // CloudLinux/AlmaLinux (OpenSSL 3). If your host uses OpenSSL 1.1 use
  // "rhel-openssl-1.1.x", or Debian/Ubuntu -> "debian-openssl-3.0.x".
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (PgBouncer) — app runtime
  directUrl = env("DIRECT_URL") // unpooled — Prisma Migrate
}

// ── Auth & identity ───────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  username       String    @unique
  email          String    @unique
  fullName       String
  phone          String?
  role           String    @default("user") // user | admin

  // Auth. `passwordHash` is a self-describing scrypt string (algo, params,
  // salt and hash). The DEK is random per user, wrapped by a password-derived
  // key using `dekSalt`.
  passwordHash   String
  dekWrapped     String
  dekSalt        String

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions       Session[]
  emailTokens    EmailToken[]
  loginAttempts  LoginAttempt[]

  accounts       Account[]
  categories     Category[]
  transactions   Transaction[]
  recurringRules RecurringRule[]
  pdcs           PDC[]
  provisions     Provision[]
  provisionAllocations ProvisionAllocation[]
  budgets        Budget[]
  exchangeRates  ExchangeRate[]
  settings       AppSetting?

  @@index([email])
  @@index([role])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // sha256 of the opaque cookie token (the raw token is never stored).
  tokenHash  String   @unique
  // The user's DEK, re-encrypted with the server key so an active session can
  // decrypt data without re-deriving from the password on every request.
  encDek     String
  ip         String?
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  type       String    @default("verify_email") // verify_email
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String // username or email entered
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  success    Boolean
  reason     String? // bad_password | no_such_user | unverified | locked | ok
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([identifier])
}

// ── Domain (per-user, encrypted) ──────────────────────────────────────────────
// `*Enc` columns hold base64 AES-256-GCM ciphertext of the corresponding value.

model Account {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  nameEnc           String // encrypted name
  type              String // cash | bank | credit_card | wallet
  currency          String   @default("AED")
  openingBalanceEnc String // encrypted minor units
  safetyBufferEnc   String // encrypted minor units
  color             String   @default("#64748b")
  isArchived        Boolean  @default(false)
  // Auto-managed accounts the user never creates directly — currently the
  // credit-card liability that credit-card costs post to. Excluded from
  // "free savings" (it represents debt, not cash).
  isSystem          Boolean  @default(false)
  // Credit cards only: the day of each month the bill falls due (1–31, clamped
  // to the last day in shorter months). Costs between two consecutive due dates
  // form one statement cycle, payable on the closing due date.
  dueDay            Int?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transactions         Transaction[] @relation("AccountTransactions")
  transfersIn          Transaction[] @relation("TransferAccount")
  pdcs                 PDC[]
  provisions           Provision[]
  recurringRules       RecurringRule[]
  provisionAllocations ProvisionAllocation[]

  @@index([userId])
  @@index([userId, isArchived])
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  nameEnc   String // encrypted name
  kind      String // income | expense
  icon      String   @default("Circle")
  color     String   @default("#64748b")
  parentId  String?
  parent    Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children  Category[] @relation("SubCategories")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions   Transaction[]
  recurringRules RecurringRule[]
  budgets        Budget[]

  @@index([userId])
  @@index([userId, kind])
}

model Transaction {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              String // income | expense | transfer
  // How an expense was paid: account | debit_card | credit_card (plaintext —
  // low-sensitivity, and needed to filter the Costs sections without decrypting).
  method            String   @default("account")
  amountEnc         String // encrypted minor units
  currency          String   @default("AED")
  date              DateTime
  noteEnc           String? // encrypted note
  tagsEnc           String? // encrypted JSON array of tags
  attachmentPath    String?
  status            String   @default("posted") // posted | scheduled

  accountId         String
  account           Account  @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)

  transferAccountId String?
  transferAccount   Account? @relation("TransferAccount", fields: [transferAccountId], references: [id])

  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id])

  recurringRuleId   String?
  recurringRule     RecurringRule? @relation(fields: [recurringRuleId], references: [id])

  pdc               PDC?     @relation("PdcClearing")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, accountId, date])
  @@index([userId, type])
  @@index([userId, status])
  @@index([userId, method])
}

model RecurringRule {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  nameEnc         String // encrypted name
  type            String // income | expense
  frequency       String // weekly | monthly | yearly | custom
  interval        Int      @default(1)
  startDate       DateTime
  endDate         DateTime?
  occurrenceCount Int?
  nextRunDate     DateTime
  isActive        Boolean  @default(true)

  amountEnc       String // encrypted minor units
  currency        String   @default("AED")
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  noteEnc         String? // encrypted note

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions    Transaction[]
  pdcs            PDC[]

  @@index([userId])
  @@index([userId, nextRunDate])
  @@index([userId, isActive])
}

model PDC {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  direction           String // issued | received
  counterpartyEnc     String // encrypted
  amountEnc           String // encrypted minor units
  currency            String   @default("AED")
  issueDate           DateTime
  dueDate             DateTime
  bankNameEnc         String? // encrypted
  chequeNumberEnc     String? // encrypted
  status              String   @default("pending") // pending | cleared | bounced | cancelled | replaced
  notesEnc            String? // encrypted

  accountId           String
  account             Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  recurringRuleId     String?
  recurringRule       RecurringRule? @relation(fields: [recurringRuleId], references: [id])

  clearedTransactionId String? @unique
  clearedTransaction   Transaction? @relation("PdcClearing", fields: [clearedTransactionId], references: [id])

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([userId, direction])
}

model Provision {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  nameEnc       String // encrypted
  targetEnc     String // encrypted minor units
  currency      String   @default("AED")
  dueDate       DateTime?
  priority      Int      @default(2)
  status        String   @default("active") // active | funded | released | cancelled

  accountId     String?
  account       Account? @relation(fields: [accountId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  allocations   ProvisionAllocation[]

  @@index([userId])
  @@index([userId, dueDate])
  @@index([userId, status])
}

model ProvisionAllocation {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provisionId  String
  provision    Provision @relation(fields: [provisionId], references: [id], onDelete: Cascade)
  amountEnc    String // encrypted minor units
  date         DateTime
  noteEnc      String? // encrypted
  accountId    String?
  account      Account? @relation(fields: [accountId], references: [id])
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([provisionId])
}

model Budget {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  month        String // "YYYY-MM"
  plannedEnc   String // encrypted minor units
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([categoryId, month])
  @@index([userId, month])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  base      String
  quote     String
  rate      Float
  asOf      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, base, quote])
  @@index([userId])
}

model AppSetting {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  baseCurrency       String   @default("AED")
  defaultBufferMinor Int      @default(0)
  theme              String   @default("system")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
