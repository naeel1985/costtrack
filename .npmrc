# This is a FLAT single-app repo — it has no npm workspaces.
#
# cPanel/CloudLinux's Node Selector can leave a stale `workspaces=true` in the
# per-app nodevenv npmrc (written when this repo briefly used workspaces). That
# forces every `npm install` into workspace mode and fails with
# "No workspaces found!" even though there are none. This project-level setting
# overrides that, so `npm install` behaves normally here.
workspaces=false
